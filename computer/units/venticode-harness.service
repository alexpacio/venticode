[Unit]
Description=Managed Venticode harness
Requires=venticode-desktop.service dbus.socket
After=venticode-desktop.service dbus.socket
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/run/venticode.env
StandardError=journal
Environment=HOME=/root
RuntimeDirectory=venticode-harness
RuntimeDirectoryMode=0711
ExecStart=/usr/local/bin/venticode-harness managed
Restart=on-failure
RestartSec=2
