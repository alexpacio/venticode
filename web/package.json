{
  "name": "@venticode/web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort --host 127.0.0.1",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:bundle",
    "predev": "sh build-terminal.sh",
    "prebuild": "sh build-terminal.sh",
    "pretypecheck": "sh build-terminal.sh",
    "build:bundle": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
