{
  "name": "@venticode/web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort --host 127.0.0.1",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:bundle",
    "predev": "sh build-terminal.sh",
    "prebuild": "sh build-terminal.sh",
    "pretypecheck": "sh build-terminal.sh",
    "build:bundle": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.9.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "ws": "^8.23.0"
  }
}
